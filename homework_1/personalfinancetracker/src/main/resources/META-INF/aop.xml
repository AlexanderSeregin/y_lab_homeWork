<!DOCTYPE aspectj PUBLIC "-//AspectJ//DTD//EN" "http://www.eclipse.org/aspectj/dtd/aspectj.dtd">
<aspectj>
    <weaver>
        <!-- only weave classes in our application-specific packages -->
        <include within="website.ylab.learningplatform..*"/>
    </weaver>
    <aspects>
        <!-- declare two aspects to the weaver -->
        <aspect name="website.ylab.learningplatform.aspect.LoggingAspect"/>
        <aspect name="website.ylab.learningplatform.aspect.AuditAspect"/>
    </aspects>
</aspectj>
