<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Create schemas -->
    <changeSet id="1" author="ylab">
        <sql>CREATE SCHEMA IF NOT EXISTS finance_schema</sql>
        <sql>CREATE SCHEMA IF NOT EXISTS service_schema</sql>
    </changeSet>

    <!-- Include schema creation changelog -->
    <include file="db/changelog/changes/01-create-tables.xml" relativeToChangelogFile="false"/>

    <!-- Include data initialization changelog -->
    <include file="db/changelog/changes/02-init-data.xml" relativeToChangelogFile="false"/>

</databaseChangeLog>
