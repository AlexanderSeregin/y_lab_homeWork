<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Create sequences in service schema -->
    <changeSet id="01-create-sequences" author="ylab">
        <createSequence sequenceName="user_seq" schemaName="service_schema" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="transaction_seq" schemaName="service_schema" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="budget_seq" schemaName="service_schema" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="goal_seq" schemaName="service_schema" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="notification_seq" schemaName="service_schema" startValue="1" incrementBy="1"/>
    </changeSet>

    <!-- Create user table -->
    <changeSet id="02-create-user-table" author="ylab">
        <createTable tableName="users" schemaName="finance_schema">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="is_admin" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_blocked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="DECIMAL(19,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!-- Create transactions table -->
    <changeSet id="04-create-transaction-table" author="ylab">
        <createTable tableName="transactions" schemaName="finance_schema">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_transaction_user" references="finance_schema.users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="is_income" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
            </column>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="transaction_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Create budgets table -->
    <changeSet id="05-create-budget-table" author="ylab">
        <createTable tableName="budgets" schemaName="finance_schema">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_budget_user" references="finance_schema.users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Create goals table -->
    <changeSet id="06-create-goal-table" author="ylab">
        <createTable tableName="goals" schemaName="finance_schema">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_goal_user" references="finance_schema.users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="target_amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Create notifications table -->
    <changeSet id="07-create-notification-table" author="ylab">
        <createTable tableName="notifications" schemaName="finance_schema">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_notification_user"
                             references="finance_schema.users(id)" deleteCascade="true"/>
            </column>
            <column name="message" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
